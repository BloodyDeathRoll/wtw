{
  "name": "wtw",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-voice-samples": "node --env-file=.env.local scripts/generate-voice-samples.mjs",
    "grow-catalog": "node --env-file=.env.local --conditions=react-server --import tsx scripts/grow-catalog.mts",
    "backfill-trailers": "node --env-file=.env.local --conditions=react-server --import tsx scripts/backfill-trailers.mts",
    "backfill-language-keywords": "node --env-file=.env.local --conditions=react-server --import tsx scripts/backfill-language-keywords.mts",
    "backfill-content-affinity": "node --env-file=.env.local --conditions=react-server --import tsx scripts/backfill-content-affinity.mts",
    "repair-title-keys": "node --env-file=.env.local --conditions=react-server --import tsx scripts/repair-title-keys.mts",
    "generate-icons": "node scripts/generate-icons.mjs",
    "record-intro": "node --env-file=.env.local --import tsx scripts/record-intro.mts",
    "build-play-titles": "node --env-file=.env.local --conditions=react-server --import tsx scripts/build-play-titles.mts",
    "build-six-chains": "node --env-file=.env.local --import tsx scripts/build-six-chains.mts",
    "build-cast-call": "node --env-file=.env.local --conditions=react-server --import tsx scripts/build-cast-call.mts",
    "build-line-up": "node --env-file=.env.local --conditions=react-server --import tsx scripts/build-line-up.mts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.58",
    "@ai-sdk/mistral": "^4.0.56",
    "@ai-sdk/react": "^4.0.136",
    "@ducanh2912/next-pwa": "^10",
    "@google/genai": "^2.6.0",
    "@supabase/ssr": "^0.12",
    "@supabase/supabase-js": "^2",
    "@upstash/redis": "^1",
    "ai": "^7.0.151",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "framer-motion": "^14",
    "lucide-react": "^1.49",
    "next": "^16.4.2",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.1",
    "postcss": "^8",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
